# Copy this file to ".env.local" and fill in the values.
# On Vercel, add these in: Project -> Settings -> Environment Variables.

# Your live website address (used for SEO / social-share previews)
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Contact form email delivery (free account at https://resend.com)
RESEND_API_KEY=
# The inbox where contact-form messages should arrive
CONTACT_TO_EMAIL=
