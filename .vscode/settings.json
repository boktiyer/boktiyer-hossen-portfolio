{
  // Tailwind CSS v4 uses @theme, @utility, @apply etc. which VS Code's
  // built-in CSS checker doesn't know — this stops the false warnings.
  "css.lint.unknownAtRules": "ignore",
  "files.associations": {
    "*.css": "tailwindcss"
  },
  // Use the project's TypeScript version
  "typescript.tsdk": "node_modules/typescript/lib",
  "editor.quickSuggestions": {
    "strings": "on"
  }
}
